diff --git a/src/http3serversession.cc b/src/http3serversession.cc
--- a/src/http3serversession.cc
+++ b/src/http3serversession.cc
@@ -13,0 +14,1 @@
+#include <vector>
@@ -50,0 +51,13 @@
+  void Http3ServerSession::OnConnectionClosed(
+      const QuicConnectionCloseFrame &frame, ConnectionCloseSource source) {
+    std::vector<Http3WTSession::Visitor *> visitors;
+    visitors.reserve(svisitors_.size());
+    for (const auto &entry : svisitors_) {
+      if (entry.second != nullptr) visitors.push_back(entry.second);
+    }
+    for (Http3WTSession::Visitor *visitor : visitors) {
+      visitor->OnSessionClosed(0, "quic_connection_closed");
+    }
+    QuicServerSessionBase::OnConnectionClosed(frame, source);
+  }
+
